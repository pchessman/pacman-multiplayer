<?xml version="1.0" encoding="utf-8"?>
<!-- The app never uses the network (no INTERNET permission). If that ever changes,
     this still forbids plain-text traffic and user-installed certificates. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
